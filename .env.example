# ==============================================================================
# 📝 ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Copy this file to create your environment-specific config:
#   - .env.development (for local development)
#   - .env.production (for Vercel deployment)
#   - .env.test (for Playwright tests)
#
# 🔒 IMPORTANT: Never commit real secrets to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 🗄️  DATABASE (Neon PostgreSQL)
# ------------------------------------------------------------------------------
# Get these from: https://console.neon.tech
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host:5432/dbname?sslmode=require"

# ------------------------------------------------------------------------------
# 🔐 AUTHENTICATION (Better Auth)
# ------------------------------------------------------------------------------
# BETTER_AUTH_SECRET: Generate with: `openssl rand -base64 32`
# BETTER_AUTH_URL: Your app URL (http://localhost:3000 for dev, https://yourapp.com for prod)
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="your-generated-secret-here"

# ------------------------------------------------------------------------------
# 🎭 OAUTH PROVIDERS (Optional)
# ------------------------------------------------------------------------------
# Get credentials from respective developer portals:
# - GitHub: https://github.com/settings/developers
# - Google: https://console.cloud.google.com/apis/credentials
# - Discord: https://discord.com/developers/applications

## GitHub OAuth
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

## Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

## Discord OAuth (for website login)
DISCORD_CLIENT_ID="your-discord-client-id"
DISCORD_CLIENT_SECRET="your-discord-client-secret"

# ------------------------------------------------------------------------------
# 🤖 DISCORD BOT (Optional)
# ------------------------------------------------------------------------------
# Get token from: https://discord.com/developers/applications
# See docs/DISCORD_BOT.md for setup instructions
DISCORD_BOT_TOKEN="your-bot-token-here"
DISCORD_GUILD_ID="your-server-id-here"
DISCORD_BOT_ENABLED="false"  # Set to "true" to enable bot

# ------------------------------------------------------------------------------
# 📧 EMAIL (Resend)
# ------------------------------------------------------------------------------
# Get API key from: https://resend.com/api-keys
RESEND_API_KEY="re_your_api_key_here"
RESEND_AUDIENCE_ID="your-audience-id"
EMAIL_FROM="noreply@yourapp.com"
NEXT_PUBLIC_EMAIL_CONTACT="contact@yourapp.com"

# ------------------------------------------------------------------------------
# 💳 CRYPTO PAYMENTS (MyCryptoPilot specific)
# ------------------------------------------------------------------------------
# RPC URLs for blockchain payment detection
BASE_RPC_URL="https://mainnet.base.org"
TRON_RPC_URL="https://api.trongrid.io"

# HD Wallet Extended Public Keys
# ⚠️ CRITICAL: Generate unique keys for production
# See: scripts/generate-xpub.sh (to be created)
CRYPTO_XPUB_BASE="your-base-xpub-here"
CRYPTO_XPUB_TRON="your-tron-xpub-here"

# ------------------------------------------------------------------------------
# 💰 STRIPE (Legacy - Not used in MyCryptoPilot)
# ------------------------------------------------------------------------------
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_your_key_here"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your_key_here"
STRIPE_WEBHOOK_SECRET="whsec_your_secret_here"
STRIPE_PRO_PLAN_ID="prod_your_plan_id"
STRIPE_PRO_YEARLY_PLAN_ID="prod_your_plan_id"
STRIPE_ULTRA_PLAN_ID="prod_your_plan_id"
STRIPE_ULTRA_YEARLY_PLAN_ID="prod_your_plan_id"

# ------------------------------------------------------------------------------
# 📊 ANALYTICS (Optional)
# ------------------------------------------------------------------------------
# Get from: https://posthog.com
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST=""

# ------------------------------------------------------------------------------
# 📁 FILE UPLOAD (Optional)
# ------------------------------------------------------------------------------
# Get from: https://uploadthing.com
UPLOADTHING_TOKEN=""
