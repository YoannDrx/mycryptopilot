# ==============================================================================
# 📝 ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# For LOCAL DEVELOPMENT:
#   1. Copy this file to .env.local
#      cp .env.example .env.local
#   2. Fill in your local values
#   3. NEVER commit .env.local!
#
# For PRODUCTION (Vercel):
#   - DO NOT use .env files
#   - Set all variables in Vercel Dashboard > Settings > Environment Variables
#   - CRITICAL: Set BETTER_AUTH_URL=https://www.mycryptopilot.app (Production only)
#
# For complete documentation, see: .claude/docs/ENV-VARIABLES-MAPPING.md
# ==============================================================================

# ------------------------------------------------------------------------------
# 🗄️  DATABASE (PostgreSQL via Neon)
# ------------------------------------------------------------------------------
# Get connection strings from: https://console.neon.tech
# You need both pooled (DATABASE_URL) and direct (DATABASE_URL_UNPOOLED)
DATABASE_URL=""
DATABASE_URL_UNPOOLED=""

# ------------------------------------------------------------------------------
# 🔐 AUTHENTICATION (Better Auth)
# ------------------------------------------------------------------------------
# BETTER_AUTH_SECRET: Generate with `openssl rand -base64 32` (REQUIRED)
# BETTER_AUTH_URL: Your app URL - MUST match OAuth redirect URIs exactly!
#   - Development: http://localhost:3000
#   - Production: https://www.mycryptopilot.app (set in Vercel Dashboard)
#   - CRITICAL: If wrong, OAuth (Discord/GitHub/Google) will fail!
BETTER_AUTH_URL=""
BETTER_AUTH_SECRET=""

# ------------------------------------------------------------------------------
# 🎭 OAUTH PROVIDERS
# ------------------------------------------------------------------------------
# You need SEPARATE apps for dev and production with different redirect URIs!
# Get credentials from:
# - GitHub: https://github.com/settings/developers
# - Google: https://console.cloud.google.com/apis/credentials
# - Discord: https://discord.com/developers/applications

## GitHub OAuth (Create separate apps for dev/prod)
# Redirect URI: http://localhost:3000/api/auth/callback/github (dev)
#               https://www.mycryptopilot.app/api/auth/callback/github (prod)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

## Google OAuth (Can use same app with multiple redirect URIs)
# Redirect URI: http://localhost:3000/api/auth/callback/google (dev)
#               https://www.mycryptopilot.app/api/auth/callback/google (prod)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

## Discord OAuth (Can use same app with multiple redirect URIs)
# Redirect URI: http://localhost:3000/api/auth/callback/discord (dev)
#               https://www.mycryptopilot.app/api/auth/callback/discord (prod)
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# ------------------------------------------------------------------------------
# 🤖 DISCORD BOT
# ------------------------------------------------------------------------------
# Get token from: https://discord.com/developers/applications
# IMPORTANT: Bot tourne sur le worker Fly.io (process séparé de Vercel)
DISCORD_BOT_TOKEN=""
DISCORD_GUILD_ID=""
DISCORD_BOT_ENABLED=""  # Set to "true" to enable (default: "false")
DISCORD_INVITE_URL=""   # Permanent invite link for email onboarding

## Discord Channels
# Get IDs from: Right-click channel → Copy ID (Enable Developer Mode first)
DISCORD_FREE_SIGNALS_CHANNEL_ID=""  # Channel #signals-free for teasers
DISCORD_LOG_CHANNEL_ID=""           # Channel #bot-logs for monitoring

## Discord Roles
# Get IDs from: Server Settings → Roles → Right-click role → Copy ID
DISCORD_ROLE_ADMIN_ID=""   # Admin role ID
DISCORD_FREE_ROLE_ID=""    # Free tier role
DISCORD_PRO_ROLE_ID=""     # Pro tier role
DISCORD_ULTRA_ROLE_ID=""   # Ultra tier role

## Discord Webhook
# Create webhook in channel settings
DISCORD_WEBHOOK_SIGNALS_URL=""  # Webhook for posting signals

# ------------------------------------------------------------------------------
# 📧 EMAIL (Resend)
# ------------------------------------------------------------------------------
# Get API key from: https://resend.com/api-keys
RESEND_API_KEY=""
RESEND_AUDIENCE_ID=""
EMAIL_FROM="MyCryptoPilot <mycryptopilot@yodev.fr>"
NEXT_PUBLIC_EMAIL_CONTACT="hello@mycryptopilot.app"

# ------------------------------------------------------------------------------
# 💳 CRYPTO PAYMENTS (HD Wallet)
# ------------------------------------------------------------------------------
# Network Mode: "mainnet" (production) or "testnet" (development)
CRYPTO_NETWORK=""

## RPC URLs - Mainnet (Production)
# Use these in production for real transactions
BASE_RPC_URL=""   # e.g. https://mainnet.base.org
TRON_RPC_URL=""   # e.g. https://api.trongrid.io

## RPC URLs - Testnet (Development)
# Use these in development/preview for testing (no real money)
BASE_RPC_URL_TESTNET=""   # e.g. https://sepolia.base.org
TRON_RPC_URL_TESTNET=""   # e.g. https://api.shasta.trongrid.io

## TronGrid API Key (Optional - improves rate limits)
# Get from: https://www.trongrid.io/dashboard/keys/create
# ⚠️  Optional but recommended for production to avoid rate limiting
TRON_API_KEY=""

## HD Wallet Extended Public Keys (XPUB)
# CRITICAL: Use DIFFERENT XPUBs for mainnet vs testnet!
# Generate with: npx tsx scripts/generate-mainnet-xpubs.ts (production)
#                npx tsx scripts/generate-testnet-xpubs.ts (development)
# ⚠️  NEVER commit seed phrases! Only XPUBs are safe to use here.

# Mainnet XPUBs (production only)
CRYPTO_XPUB_BASE=""   # Base network XPUB (mainnet)
CRYPTO_XPUB_TRON=""   # Tron network XPUB (mainnet)

# Testnet XPUBs (development/preview only)
CRYPTO_XPUB_BASE_TESTNET=""   # Base Sepolia XPUB (testnet)
CRYPTO_XPUB_TRON_TESTNET=""   # Tron Shasta XPUB (testnet)

## Binance Master Wallets (for sweep operations)
# These are the destination wallets where payments are swept to
BINANCE_MASTER_WALLET_BASE=""   # Base network address (0x...)
BINANCE_MASTER_WALLET_TRON=""   # Tron network address (T...)

# ------------------------------------------------------------------------------
# 📊 PORTFOLIO TRACKING (Exchange Integration)
# ------------------------------------------------------------------------------
# Binance/Bybit API keys for portfolio tracking feature
# ⚠️  Use READ-ONLY keys! Never use keys with trading permissions.
# Get from:
#   - Binance: https://www.binance.com/en/my/settings/api-management
#   - Bybit: https://www.bybit.com/app/user/api-management

## Binance API (Read-only for development testing)
BINANCE_USER_API_KEY=""
BINANCE_USER_SECRET_KEY=""

## Bybit API (Read-only for development testing)
BYBIT_USER_API_KEY=""
BYBIT_USER_SECRET_KEY=""

## Bitget readonly API keys (for development testing)
BITGET_USER_API_KEY=""
BITGET_USER_SECRET_KEY=""
BITGET_PASSPHRASE=""

# ------------------------------------------------------------------------------
# 🔐 ENCRYPTION (Sensitive Data)
# ------------------------------------------------------------------------------
# CRITICAL: Used to encrypt API keys in database (AES-256-GCM)
# Generate with: openssl rand -hex 32
# ⚠️  NEVER change in production (would invalidate all encrypted keys)
# ⚠️  NEVER commit this value to git!
ENCRYPTION_SECRET=""

# ------------------------------------------------------------------------------
# ⏰ CRON JOBS (Vercel Cron)
# ------------------------------------------------------------------------------
# Secret for authenticating cron job requests
# Generate with: openssl rand -base64 32
CRON_SECRET=""

# ------------------------------------------------------------------------------
# 🛠 FLY WORKER (Cron + Payment Watcher)
# ------------------------------------------------------------------------------
# Interval between payment watcher polls (ms). Default: 60000 (1 minute)
PAYMENT_WATCHER_INTERVAL_MS="60000"

# ------------------------------------------------------------------------------
# 💰 STRIPE (Legacy - NOT USED in MyCryptoPilot)
# ------------------------------------------------------------------------------
# Kept for compatibility with NOW.TS template
# MyCryptoPilot uses crypto payments instead - these are optional
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_PRO_PLAN_ID=""
STRIPE_PRO_YEARLY_PLAN_ID=""
STRIPE_ULTRA_PLAN_ID=""
STRIPE_ULTRA_YEARLY_PLAN_ID=""

# ------------------------------------------------------------------------------
# 🌐 PUBLIC VARIABLES (Exposed to Browser)
# ------------------------------------------------------------------------------
# These variables are accessible in the browser (prefix NEXT_PUBLIC_)
NEXT_PUBLIC_APP_URL=""              # e.g. http://localhost:3000 (dev) or https://www.mycryptopilot.app (prod)
NEXT_PUBLIC_EMAIL_CONTACT=""        # Public contact email
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""  # Stripe public key (legacy, optional)

# ------------------------------------------------------------------------------
# 📊 ANALYTICS (Optional)
# ------------------------------------------------------------------------------
# Get from: https://posthog.com
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST=""

# ------------------------------------------------------------------------------
# 📁 FILE UPLOAD (Optional)
# ------------------------------------------------------------------------------
# Get from: https://uploadthing.com
UPLOADTHING_TOKEN=""

# ------------------------------------------------------------------------------
# 🔴 REDIS (Upstash) - SSE pub/sub and BullMQ
# ------------------------------------------------------------------------------
# Get from: https://console.upstash.com/redis
# 1. Create Regional database (eu-west-1)
# 2. Eviction: noeviction (important for BullMQ)
# 3. Copy connection string from "Redis" tab (NOT REST API)
# Format: rediss://default:PASSWORD@your-redis.upstash.io:6379
# Used for:
# - SSE pub/sub (real-time balance updates for traders)
# - BullMQ job queue (copy-trading automation)
# - Circuit breaker (distributed rate limiting)
REDIS_URL=""

# ==============================================================================
# 📚 ADDITIONAL RESOURCES
# ==============================================================================
# Complete documentation: .claude/docs/ENV-VARIABLES-MAPPING.md
# Synchronization tool: /sync-env command (verifies env vars are in sync)
# Environment checklist: ENV_CHECKLIST.md (if exists)
#
# For production deployment:
#   - Set all variables in Vercel Dashboard (NOT in .env files)
#   - Use mainnet XPUBs and RPC URLs
#   - Set CRYPTO_NETWORK="mainnet"
#   - Set BETTER_AUTH_URL="https://www.mycryptopilot.app"
#
# For development:
#   - Copy this file to .env.local
#   - Use testnet XPUBs and RPC URLs
#   - Set CRYPTO_NETWORK="testnet"
#   - Set BETTER_AUTH_URL="http://localhost:3000"
# ==============================================================================
