# ==============================================================================
# 📝 ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# For LOCAL DEVELOPMENT:
#   1. Copy this file to .env.local
#      cp .env.example .env.local
#   2. Fill in your local values
#   3. NEVER commit .env.local!
#
# For PRODUCTION (Vercel):
#   - DO NOT use .env files
#   - Set all variables in Vercel Dashboard > Settings > Environment Variables
#   - CRITICAL: Set BETTER_AUTH_URL=https://www.mycryptopilot.app (Production only)
# ==============================================================================

# ------------------------------------------------------------------------------
# 🗄️  DATABASE (PostgreSQL)
# ------------------------------------------------------------------------------
# Get connection strings from: https://console.neon.tech
# You need both pooled (DATABASE_URL) and direct (DATABASE_URL_UNPOOLED)
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require"

# ------------------------------------------------------------------------------
# 🔐 AUTHENTICATION (Better Auth)
# ------------------------------------------------------------------------------
# BETTER_AUTH_SECRET: Generate with `openssl rand -base64 32` (REQUIRED)
# BETTER_AUTH_URL: Your app URL - MUST match OAuth redirect URIs exactly!
#   - Development: http://localhost:3000
#   - Production: https://www.mycryptopilot.app (set in Vercel Dashboard)
#   - CRITICAL: If wrong, OAuth (Discord/GitHub/Google) will fail!
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="your-generated-secret-here"

# ------------------------------------------------------------------------------
# 🎭 OAUTH PROVIDERS (Optional)
# ------------------------------------------------------------------------------
# You need SEPARATE apps for dev and production with different redirect URIs!
# Get credentials from:
# - GitHub: https://github.com/settings/developers
# - Google: https://console.cloud.google.com/apis/credentials
# - Discord: https://discord.com/developers/applications

## GitHub OAuth (Create separate apps for dev/prod)
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

## Google OAuth (Can use same app with multiple redirect URIs)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

## Discord OAuth (Can use same app with multiple redirect URIs)
# Redirect URIs to configure:
#   - Dev: http://localhost:3000/api/auth/callback/discord
#   - Prod: https://www.mycryptopilot.app/api/auth/callback/discord
DISCORD_CLIENT_ID="your-discord-client-id"
DISCORD_CLIENT_SECRET="your-discord-client-secret"

# ------------------------------------------------------------------------------
# 🤖 DISCORD BOT (Optional)
# ------------------------------------------------------------------------------
# Get token from: https://discord.com/developers/applications
# See docs/DISCORD_BOT.md for setup instructions
# IMPORTANT: Bot runs on Railway/Fly.io, NOT on Vercel (serverless limitation)
DISCORD_BOT_TOKEN="your-bot-token-here"
DISCORD_GUILD_ID="your-server-id-here"
DISCORD_BOT_ENABLED="false"  # Set to "true" to enable (local dev or Railway)

# ------------------------------------------------------------------------------
# 📧 EMAIL (Resend)
# ------------------------------------------------------------------------------
# Get API key from: https://resend.com/api-keys
RESEND_API_KEY="re_your_api_key_here"
RESEND_AUDIENCE_ID="your-audience-id"
EMAIL_FROM="noreply@yourapp.com"
NEXT_PUBLIC_EMAIL_CONTACT="contact@yourapp.com"

# ------------------------------------------------------------------------------
# 💳 CRYPTO PAYMENTS (MyCryptoPilot Specific)
# ------------------------------------------------------------------------------
# RPC URLs for blockchain payment detection
BASE_RPC_URL="https://mainnet.base.org"
TRON_RPC_URL="https://api.trongrid.io"

# HD Wallet Extended Public Keys
# ⚠️ CRITICAL: Generate unique keys for production (NEVER reuse dev keys!)
# See: docs/ENV_SIMPLIFICATION_ANALYSIS.md for generation instructions
CRYPTO_XPUB_BASE="your-base-xpub-here"
CRYPTO_XPUB_TRON="your-tron-xpub-here"

## Binance Wallet
BINANCE_MASTER_WALLET_BASE="BASE_USDC_ADRESS"
BINANCE_MASTER_WALLET_TRON="TRON_USDT_ADRESS"

# ------------------------------------------------------------------------------
# 💰 STRIPE (Legacy - Not Used in MyCryptoPilot)
# ------------------------------------------------------------------------------
# Kept for compatibility with NOW.TS template
# MyCryptoPilot uses crypto payments instead
STRIPE_SECRET_KEY="sk_test_your_key_here"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your_key_here"
STRIPE_WEBHOOK_SECRET="whsec_your_secret_here"
STRIPE_PRO_PLAN_ID="prod_your_plan_id"
STRIPE_PRO_YEARLY_PLAN_ID="prod_your_plan_id"
STRIPE_ULTRA_PLAN_ID="prod_your_plan_id"
STRIPE_ULTRA_YEARLY_PLAN_ID="prod_your_plan_id"

# ------------------------------------------------------------------------------
# 📊 ANALYTICS (Optional)
# ------------------------------------------------------------------------------
# Get from: https://posthog.com
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST=""

# ------------------------------------------------------------------------------
# 📁 FILE UPLOAD (Optional)
# ------------------------------------------------------------------------------
# Get from: https://uploadthing.com
UPLOADTHING_TOKEN=""
