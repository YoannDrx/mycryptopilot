# ==============================================================================
# 🧪 TEST OVERRIDES (E2E Tests) - EXAMPLE TEMPLATE
# ==============================================================================
# Ce fichier est un TEMPLATE pour configurer les overrides de test
#
# 📝 SETUP INSTRUCTIONS:
#     1. Copier ce fichier: cp .env.test.local.example .env.test.local
#     2. Ajuster YOUR_USERNAME avec votre username PostgreSQL
#     3. Ne jamais committer .env.test.local (déjà dans .gitignore)
#
# 🎯 OBJECTIF CRITIQUE:
#     Ce fichier OVERRIDE .env.local en mode test pour forcer l'utilisation
#     de la DB locale PostgreSQL au lieu de la DB Neon (dev)
#
# ⚠️  PRIORITÉ Next.js (NODE_ENV=test):
#     1. .env.test.local      ← Votre fichier local (PRIORITÉ MAX)
#     2. .env.local           ← Overridé par ce fichier
#     3. .env.test            ← Variables non-overridées
#     4. .env                 ← Fallback
#
# 🐛 PROBLÈME RÉSOLU - Erreurs Prisma P2025:
#
#     AVANT (sans .env.test.local):
#     ❌ .env.local était chargé pendant les tests
#     ❌ Next.js utilisait Neon DB (DATABASE_URL de .env.local)
#     ❌ Prisma utilisait PostgreSQL local (DATABASE_URL de .env.test)
#     ❌ Résultat: Users créés dans Neon, recherchés dans local → P2025 errors
#
#     MAINTENANT (avec .env.test.local):
#     ✅ Ce fichier override .env.local en mode test
#     ✅ Next.js ET Prisma utilisent tous deux PostgreSQL local
#     ✅ 0 erreurs P2025!
#
# 📚 DOCUMENTATION COMPLÈTE:
#     Voir: .claude/docs/E2E-TESTS-FINAL-REPORT.md
#     Section: "Prisma Cache Synchronization Fix"
#
# ⚠️ Ce fichier est COMMITABLE (pas de secrets, juste la structure)
# ==============================================================================

# ------------------------------------------------------------------------------
# 🗄️  DATABASE (PostgreSQL Local - Override Neon DB)
# ------------------------------------------------------------------------------
# Force l'utilisation de la database locale de test au lieu de Neon
# Cette DB est créée par: pnpm db:setup-test
#
# ⚠️  Remplacer YOUR_USERNAME par votre username PostgreSQL
#     - macOS (Postgres.app): Généralement votre username macOS
#     - Linux: Généralement 'postgres'
#     - Windows: Généralement 'postgres'
#
# Vérifier votre username: whoami (macOS/Linux) ou echo %USERNAME% (Windows)
DATABASE_URL="postgresql://YOUR_USERNAME:@localhost:5432/mycryptopilot_test"
DATABASE_URL_UNPOOLED="postgresql://YOUR_USERNAME:@localhost:5432/mycryptopilot_test"

# ------------------------------------------------------------------------------
# 🧪 PLAYWRIGHT CONFIGURATION
# ------------------------------------------------------------------------------
# Enable CI mode for longer timeouts (15s → 30s for assertions & actions)
CI=true

# ==============================================================================
# 📝 NOTES IMPORTANTES
# ==============================================================================
#
# 1. Ce fichier ne contient QUE les variables critiques à override en test
#    Toutes les autres variables sont héritées de .env.test et .env.local
#
# 2. Si vous utilisez Neon DB en développement (.env.local), ce fichier est
#    OBLIGATOIRE pour éviter les erreurs Prisma P2025
#
# 3. Exemples d'autres overrides possibles (si nécessaire):
#    - CRYPTO_NETWORK="testnet"  (si .env.local utilise mainnet)
#    - DISCORD_BOT_ENABLED="false"  (désactiver bot pendant tests)
#    - RESEND_API_KEY=""  (désactiver emails réels)
#
# 4. Pour vérifier que ce fichier est chargé correctement:
#    - Lancer: NODE_ENV=test pnpm test:e2e:ci
#    - Chercher dans logs: "[dotenv] injecting env from .env.test.local"
#
# ==============================================================================
# 🧪 TROUBLESHOOTING
# ==============================================================================
#
# Erreur "P2025: No record was found":
#   → Vérifier que .env.test.local existe
#   → Vérifier que DATABASE_URL pointe vers PostgreSQL local
#   → Vérifier que la DB mycryptopilot_test existe (pnpm db:setup-test)
#
# Erreur "connection refused":
#   → Vérifier que PostgreSQL est démarré
#   → Vérifier le username dans DATABASE_URL
#   → macOS: Ouvrir Postgres.app
#
# Voir la documentation complète pour plus d'aide:
#   .claude/docs/E2E-TESTS-FINAL-REPORT.md
#
# ==============================================================================

# ------------------------------------------------------------------------------
# 🔴 REDIS (Upstash) - SSE pub/sub and BullMQ
# ------------------------------------------------------------------------------
REDIS_URL="rediss://default:YOUR_UPSTASH_PASSWORD@your-redis.upstash.io:6379"
