# ==============================================================================
# 🚂 RAILWAY PRODUCTION ENVIRONMENT VARIABLES
# ==============================================================================
# This file documents ALL variables needed for the Discord Bot on Railway
#
# SETUP INSTRUCTIONS:
# 1. Go to Railway Dashboard → Your Project → Variables tab
# 2. Add each variable below with your actual values
# 3. Railway will auto-redeploy when you add/update variables
# 4. Verify deployment in the "Deployments" tab
# ==============================================================================

# ------------------------------------------------------------------------------
# 🗄️  DATABASE (Required)
# ------------------------------------------------------------------------------
# Use the SAME database as Vercel (Neon production)
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require"

# ------------------------------------------------------------------------------
# 🔐 AUTHENTICATION (Required for bot to validate users)
# ------------------------------------------------------------------------------
BETTER_AUTH_URL="https://www.mycryptopilot.app"
BETTER_AUTH_SECRET="your-production-secret-from-vercel"

# ------------------------------------------------------------------------------
# 🤖 DISCORD BOT (Required)
# ------------------------------------------------------------------------------
# Get these from: https://discord.com/developers/applications

# Bot token (CRITICAL - Keep secret!)
DISCORD_BOT_TOKEN="your-bot-token-here"

# Server (Guild) ID where bot will operate
DISCORD_GUILD_ID="your-server-id-here"

# Enable the bot
DISCORD_BOT_ENABLED="true"

# ------------------------------------------------------------------------------
# 📺 DISCORD CHANNELS (Required for bot features)
# ------------------------------------------------------------------------------
# Get IDs: Right-click channel → Copy ID (Enable Developer Mode first)

# Channel for posting free signal teasers (required for /admin-test-signal)
DISCORD_FREE_SIGNALS_CHANNEL_ID="your-signals-free-channel-id"

# Channel for bot logs and monitoring
DISCORD_LOG_CHANNEL_ID="your-logs-channel-id"

# ------------------------------------------------------------------------------
# 👮 DISCORD ROLES (Optional but recommended)
# ------------------------------------------------------------------------------
# Get ID: Right-click role → Copy ID (Enable Developer Mode first)

# Admin role ID for admin-only commands
DISCORD_ROLE_ADMIN_ID="your-admin-role-id"

# ------------------------------------------------------------------------------
# 🎭 OAUTH (Required for Discord OAuth login)
# ------------------------------------------------------------------------------
# IMPORTANT: Use the SAME credentials as Vercel (production OAuth app)

# Discord OAuth credentials (for website login, not bot)
DISCORD_CLIENT_ID="your-discord-client-id"
DISCORD_CLIENT_SECRET="your-discord-client-secret"

# ------------------------------------------------------------------------------
# 📧 EMAIL (Required for sending notifications)
# ------------------------------------------------------------------------------
# Use the SAME credentials as Vercel
RESEND_API_KEY="re_your_api_key_here"
EMAIL_FROM="contact@mycryptopilot.app"

# ------------------------------------------------------------------------------
# 🌍 ENVIRONMENT (Required)
# ------------------------------------------------------------------------------
# Set to "production" for Railway deployment
NODE_ENV="production"

# ==============================================================================
# ✅ VERIFICATION CHECKLIST
# ==============================================================================
# After adding all variables on Railway:
# 1. Check "Deployments" tab - should show "Deployment created" automatically
# 2. Wait 2-3 minutes for build + deploy
# 3. Check "Logs" tab - should see "Discord bot logged in as..."
# 4. Test on Discord: /admin-test-signal should work!
# ==============================================================================
