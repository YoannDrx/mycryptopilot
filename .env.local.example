# ==============================================================================
# 🚧 DEVELOPMENT ENVIRONMENT (TESTNET) - EXAMPLE TEMPLATE
# ==============================================================================
# Ce fichier est un TEMPLATE pour configurer votre environnement de développement
#
# 📝 SETUP INSTRUCTIONS:
#     1. Copier ce fichier: cp .env.local.example .env.local
#     2. Remplir les valeurs avec vos propres credentials
#     3. Ne jamais committer .env.local (déjà dans .gitignore)
#
# ⚠️  PRIORITÉ Next.js (NODE_ENV=development):
#     1. .env.development.local  ← Non utilisé (future migration possible)
#     2. .env.local              ← Votre fichier local (HAUTE priorité)
#     3. .env.development        ← Non utilisé actuellement
#     4. .env                    ← Fallback commun
#
# ⚠️ Ce fichier est COMMITABLE (pas de secrets, juste la structure)
# ==============================================================================

# ------------------------------------------------------------------------------
# 🗄️  DATABASE (Neon "vercel-dev" branch)
# ------------------------------------------------------------------------------
# Get from: https://console.neon.tech > mycryptopilot > vercel-dev branch
# Uses Neon "vercel-dev" branch (auto-managed by Vercel integration)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# ------------------------------------------------------------------------------
# 🔐 AUTHENTICATION (Better Auth)
# ------------------------------------------------------------------------------
# BETTER_AUTH_SECRET: Generate with `openssl rand -base64 32`
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="YOUR_BETTER_AUTH_SECRET_HERE"

# ------------------------------------------------------------------------------
# 🌐 APP URL (Local development)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 🎭 OAUTH PROVIDERS (Development - O-DEV:3000)
# ------------------------------------------------------------------------------
# ⚠️  Separate OAuth apps for dev and prod with different redirect URIs!
# Redirect URIs configured: http://localhost:3000/api/auth/callback/*

## GitHub OAuth
# Get from: https://github.com/settings/developers
GITHUB_CLIENT_ID="YOUR_GITHUB_CLIENT_ID"
GITHUB_CLIENT_SECRET="YOUR_GITHUB_CLIENT_SECRET"

## Google OAuth
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"

## Discord OAuth (for website login)
# Get from: https://discord.com/developers/applications
DISCORD_CLIENT_ID="YOUR_DISCORD_CLIENT_ID"
DISCORD_CLIENT_SECRET="YOUR_DISCORD_CLIENT_SECRET"

# ------------------------------------------------------------------------------
# 🤖 DISCORD BOT (Development)
# ------------------------------------------------------------------------------
# Bot runs locally with `pnpm discord-bot` (optional)
# En production, le bot tourne sur le worker Fly.io (service séparé)
DISCORD_INVITE_URL="https://discord.gg/YOUR_INVITE"
DISCORD_BOT_TOKEN="YOUR_DISCORD_BOT_TOKEN"
DISCORD_GUILD_ID="YOUR_GUILD_ID"
DISCORD_BOT_ENABLED="true"
DISCORD_FREE_SIGNALS_CHANNEL_ID="YOUR_CHANNEL_ID"
DISCORD_LOG_CHANNEL_ID="YOUR_CHANNEL_ID"
DISCORD_ROLE_ADMIN_ID="YOUR_ROLE_ID"
DISCORD_FREE_ROLE_ID="YOUR_ROLE_ID"
DISCORD_PRO_ROLE_ID="YOUR_ROLE_ID"
DISCORD_ULTRA_ROLE_ID="YOUR_ROLE_ID"
DISCORD_WEBHOOK_SIGNALS_URL="https://discord.com/api/webhooks/YOUR_WEBHOOK"

# ------------------------------------------------------------------------------
# ⏰ CRON JOBS (Vercel Cron)
# ------------------------------------------------------------------------------
# CRON_SECRET: Generate with `openssl rand -base64 32`
CRON_SECRET="YOUR_CRON_SECRET_HERE"

# ------------------------------------------------------------------------------
# 🛠 FLY WORKER (Cron + Payment Watcher)
# ------------------------------------------------------------------------------
# Interval between payment watcher polls (ms). Default: 60000 (1 minute)
PAYMENT_WATCHER_INTERVAL_MS="60000"

# ------------------------------------------------------------------------------
# 📧 EMAIL (Resend)
# ------------------------------------------------------------------------------
# Get from: https://resend.com/api-keys
RESEND_API_KEY="re_YOUR_RESEND_API_KEY"
RESEND_AUDIENCE_ID="YOUR_AUDIENCE_ID"
EMAIL_FROM="MyCryptoPilot <noreply@do-not-reply.app>"
NEXT_PUBLIC_EMAIL_CONTACT="hello@mycryptopilot.app"

# ------------------------------------------------------------------------------
# 💳 CRYPTO PAYMENTS (TESTNET - Development Only)
# ------------------------------------------------------------------------------
# ⚠️  WARNING: These are TEST keys only. DO NOT use in production!
#
# 📝 Pour générer de nouveaux XPUBs testnet:
#    npx tsx scripts/generate-testnet-xpubs.ts
#
# 🔑 Testnet Mnemonic (12 mots - saved in 1Password "MyCryptoPilot Dev"):
#    Save your testnet seed phrase securely!

# Crypto Network Mode (testnet pour development)
CRYPTO_NETWORK="testnet"

## RPC URLs for testnet blockchain payment detection
BASE_RPC_URL_TESTNET="https://sepolia.base.org"
TRON_RPC_URL_TESTNET="https://api.shasta.trongrid.io"

## TronGrid API Key (Optional - improves rate limits)
# Get from: https://www.trongrid.io/dashboard/keys/create
TRON_API_KEY="YOUR_TRONGRID_API_KEY"

## HD Wallet Extended Public Keys (TESTNET)
# Generate with: npx tsx scripts/generate-testnet-xpubs.ts
CRYPTO_XPUB_BASE="xpub..."
CRYPTO_XPUB_TRON="xpub..."

## Binance Master Wallet (Testnet - for sweep testing)
BINANCE_MASTER_WALLET_BASE="0x..."
BINANCE_MASTER_WALLET_TRON="T..."

# ------------------------------------------------------------------------------
# 🔐 ENCRYPTION (Portfolio Tracking)
# ------------------------------------------------------------------------------
# Used to encrypt Binance/Bybit API keys in database (AES-256-GCM)
# ⚠️  Use same secret in dev/test/prod for consistency
# Generate with: openssl rand -hex 32
ENCRYPTION_SECRET="YOUR_64_CHAR_HEX_STRING_HERE"

## Binance Test API Keys (readonly)
# Get from: https://demo.binance.com/en/my/settings/api-management
BINANCE_USER_API_KEY="YOUR_BINANCE_TESTNET_API_KEY"
BINANCE_USER_SECRET_KEY="YOUR_BINANCE_TESTNET_SECRET_KEY"

## Bybit Test API Keys (readonly)
# Get from: https://testnet.bybit.com/app/user/api-management
BYBIT_USER_API_KEY="YOUR_BYBIT_TESTNET_API_KEY"
BYBIT_USER_SECRET_KEY="YOUR_BYBIT_TESTNET_SECRET_KEY"

## Bitget readonly API keys (for development testing)
BITGET_USER_API_KEY="YOUR_BITGET_TESTNET_API_KEY"
BITGET_USER_SECRET_KEY="YOUR_BITGET_TESTNET_SECRET_KEY"
BITGET_PASSPHRASE="YOUR_BITGET_TESTNET_PASSPHRASE"

# ------------------------------------------------------------------------------
# 💰 STRIPE (Legacy - Non utilisé pour MyCryptoPilot)
# ------------------------------------------------------------------------------
# Kept for compatibility with NOW.TS template
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRO_PLAN_ID="prod_..."
STRIPE_PRO_YEARLY_PLAN_ID="prod_..."
STRIPE_ULTRA_PLAN_ID="prod_..."
STRIPE_ULTRA_YEARLY_PLAN_ID="prod_..."

# ------------------------------------------------------------------------------
# 📊 ANALYTICS (Disabled in development)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST=""

# ------------------------------------------------------------------------------
# 📁 FILE UPLOAD (Optional)
# ------------------------------------------------------------------------------
UPLOADTHING_TOKEN=""

# ==============================================================================
# 🧪 TESTING NOTES
# ==============================================================================
# Pour tester le système de paiement crypto:
#
# 1. Démarrer le serveur: pnpm dev
# 2. Aller sur: http://localhost:3000/orgs/[slug]/checkout/pro
# 3. Vérifier que les adresses Base (0x...) et Tron (T...) sont générées
# 4. Obtenir testnet tokens:
#    - Base Sepolia USDC: https://faucet.circle.com/
#    - Tron Shasta USDT: https://shasta.trongrid.io/
# 5. Envoyer un petit montant (ex: 1 USDC) pour tester le flow
# 6. Observer les logs serveur pour voir la détection du paiement
# ==============================================================================

# ------------------------------------------------------------------------------
# 🔴 REDIS (Upstash) - SSE pub/sub and BullMQ
# ------------------------------------------------------------------------------
REDIS_URL="rediss://default:YOUR_UPSTASH_PASSWORD@your-redis.upstash.io:6379"
