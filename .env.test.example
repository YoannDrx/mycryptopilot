# ==============================================================================
# 🧪 TEST ENVIRONMENT (E2E Tests) - EXAMPLE TEMPLATE
# ==============================================================================
# Ce fichier est un TEMPLATE pour configurer votre environnement de test
#
# 📝 SETUP INSTRUCTIONS:
#     1. Copier ce fichier: cp .env.test.example .env.test
#     2. Remplir les valeurs avec vos credentials de test
#     3. Setup la base de données de test: pnpm db:setup-test
#     4. Ne jamais committer .env.test (déjà dans .gitignore)
#
# ⚠️  PRIORITÉ Next.js (NODE_ENV=test):
#     1. .env.test.local         ← Test overrides (TRÈS HAUTE priorité)
#                                  → Fix Prisma P2025: force DATABASE_URL local
#     2. .env.local              ← Dev variables (HAUTE priorité)
#     3. .env.test               ← Votre fichier de test (MOYENNE priorité)
#     4. .env                    ← Fallback commun
#
# 📝 NOTE IMPORTANTE:
#     Sans .env.test.local, les tests échoueront avec erreurs Prisma P2025!
#     Créez .env.test.local en copiant .env.test.local.example
#
# ⚠️ Ce fichier est COMMITABLE (pas de secrets, juste la structure)
# ==============================================================================

# ------------------------------------------------------------------------------
# 🧪 PLAYWRIGHT CONFIGURATION
# ------------------------------------------------------------------------------
# Enable CI mode for longer timeouts (15s → 30s for assertions & actions)
CI=true

# ------------------------------------------------------------------------------
# 🗄️  DATABASE (PostgreSQL local pour tests isolés)
# ------------------------------------------------------------------------------
# ⚠️  Tests utilisent une DATABASE LOCALE (pas Neon!) pour isolation complète
# ⚠️  Évite de polluer la DB de dev avec des données de test
#
# Setup de la base de test (commande automatisée):
#   pnpm db:setup-test
#
# Cette commande va:
#   1. Créer la database mycryptopilot_test si elle n'existe pas
#   2. Appliquer toutes les migrations Prisma
#   3. (Optionnel) Seed les données de test
# ⚠️  Utilise l'utilisateur macOS (pas de mot de passe) pour Postgres.app
DATABASE_URL="postgresql://YOUR_USERNAME:@localhost:5432/mycryptopilot_test"
DATABASE_URL_UNPOOLED="postgresql://YOUR_USERNAME:@localhost:5432/mycryptopilot_test"

# ------------------------------------------------------------------------------
# 🔐 AUTHENTICATION (Better Auth)
# ------------------------------------------------------------------------------
# Use same secret as dev for consistency in tests
# Generate with: openssl rand -base64 32
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="YOUR_BETTER_AUTH_SECRET_HERE"

# ------------------------------------------------------------------------------
# 🌐 APP URL (Test environment)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 🎭 OAUTH PROVIDERS (Test - Use dev credentials)
# ------------------------------------------------------------------------------
# ⚠️  Using development OAuth credentials in tests is SAFE
# Tests don't actually call OAuth providers (mocked in test environment)

## GitHub OAuth (dev credentials - safe for tests)
GITHUB_CLIENT_ID="YOUR_GITHUB_CLIENT_ID"
GITHUB_CLIENT_SECRET="YOUR_GITHUB_CLIENT_SECRET"

## Google OAuth
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"

## Discord OAuth
DISCORD_CLIENT_ID="YOUR_DISCORD_CLIENT_ID"
DISCORD_CLIENT_SECRET="YOUR_DISCORD_CLIENT_SECRET"

# ------------------------------------------------------------------------------
# 🤖 DISCORD BOT (Enabled for testing bot features)
# ------------------------------------------------------------------------------
# Bot features are tested with real Discord connection
# Uses same dev server as local development
DISCORD_INVITE_URL="https://discord.gg/YOUR_INVITE"
DISCORD_BOT_TOKEN="YOUR_DISCORD_BOT_TOKEN"
DISCORD_GUILD_ID="YOUR_GUILD_ID"
DISCORD_BOT_ENABLED="true"
DISCORD_FREE_SIGNALS_CHANNEL_ID="YOUR_CHANNEL_ID"
DISCORD_LOG_CHANNEL_ID="YOUR_CHANNEL_ID"
DISCORD_ROLE_ADMIN_ID="YOUR_ROLE_ID"
DISCORD_FREE_ROLE_ID="YOUR_ROLE_ID"
DISCORD_PRO_ROLE_ID="YOUR_ROLE_ID"
DISCORD_ULTRA_ROLE_ID="YOUR_ROLE_ID"
DISCORD_WEBHOOK_SIGNALS_URL="https://discord.com/api/webhooks/YOUR_WEBHOOK"

# ------------------------------------------------------------------------------
# ⏰ CRON JOBS (Test credentials)
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
CRON_SECRET="YOUR_CRON_SECRET_HERE"

# ------------------------------------------------------------------------------
# 🛠 FLY WORKER (Cron + Payment Watcher)
# ------------------------------------------------------------------------------
# Interval between payment watcher polls (ms). Default: 60000 (1 minute)
PAYMENT_WATCHER_INTERVAL_MS="60000"

# ------------------------------------------------------------------------------
# 📧 EMAIL (Resend - Real API key for integration tests)
# ------------------------------------------------------------------------------
# ⚠️  Tests send REAL emails (to test addresses)
# Using real Resend API to test email delivery flow
# Get from: https://resend.com/api-keys
RESEND_API_KEY="re_YOUR_RESEND_API_KEY"
RESEND_AUDIENCE_ID="YOUR_AUDIENCE_ID"
EMAIL_FROM="MyCryptoPilot <mycryptopilot@yodev.fr>"
NEXT_PUBLIC_EMAIL_CONTACT="hello@mycryptopilot.app"

# ------------------------------------------------------------------------------
# 💳 CRYPTO PAYMENTS (TESTNET for E2E tests)
# ------------------------------------------------------------------------------
# ⚠️  Tests use TESTNET to avoid real money transactions
# Same testnet XPUBs as development for consistency

# Crypto Network Mode (testnet for tests)
CRYPTO_NETWORK="testnet"

## RPC URLs for testnet
BASE_RPC_URL_TESTNET="https://sepolia.base.org"
TRON_RPC_URL_TESTNET="https://api.shasta.trongrid.io"

## TronGrid API Key (Optional - improves rate limits)
# Get from: https://www.trongrid.io/dashboard/keys/create
TRON_API_KEY="YOUR_TRONGRID_API_KEY"

## HD Wallet Extended Public Keys (TESTNET)
# Same as .env.local for test consistency
# Generate with: npx tsx scripts/generate-testnet-xpubs.ts
CRYPTO_XPUB_BASE="xpub..."
CRYPTO_XPUB_TRON="xpub..."

## Binance Master Wallet (Testnet)
BINANCE_MASTER_WALLET_BASE="0x..."
BINANCE_MASTER_WALLET_TRON="T..."

# ------------------------------------------------------------------------------
# 🔐 ENCRYPTION (Portfolio Tracking)
# ------------------------------------------------------------------------------
# Same encryption secret for test consistency
# Generate with: openssl rand -hex 32
ENCRYPTION_SECRET="YOUR_64_CHAR_HEX_STRING_HERE"

## Binance Test API Keys (readonly) - https://demo.binance.com/en/my/settings/api-management
BINANCE_USER_API_KEY="YOUR_BINANCE_TESTNET_API_KEY"
BINANCE_USER_SECRET_KEY="YOUR_BINANCE_TESTNET_SECRET_KEY"

## Bybit Test API Keys (readonly)
BYBIT_USER_API_KEY="YOUR_BYBIT_TESTNET_API_KEY"
BYBIT_USER_SECRET_KEY="YOUR_BYBIT_TESTNET_SECRET_KEY"

## Bitget readonly API keys (for development testing)
BITGET_USER_API_KEY="YOUR_BITGET_TESTNET_API_KEY"
BITGET_USER_SECRET_KEY="YOUR_BITGET_TESTNET_SECRET_KEY"
BITGET_PASSPHRASE="YOUR_BITGET_TESTNET_PASSPHRASE"

# ------------------------------------------------------------------------------
# 💰 STRIPE (Legacy - Disabled in tests)
# ------------------------------------------------------------------------------
# Stripe is not used in MyCryptoPilot - kept for NOW.TS compatibility
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRO_PLAN_ID="prod_..."
STRIPE_PRO_YEARLY_PLAN_ID="prod_..."
STRIPE_ULTRA_PLAN_ID="prod_..."
STRIPE_ULTRA_YEARLY_PLAN_ID="prod_..."

# ------------------------------------------------------------------------------
# 📊 ANALYTICS (Disabled in tests)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST=""

# ------------------------------------------------------------------------------
# 📁 FILE UPLOAD (Disabled in tests)
# ------------------------------------------------------------------------------
UPLOADTHING_TOKEN=""

# ==============================================================================
# 🧪 TEST EXECUTION NOTES
# ==============================================================================
# Setup database (une seule fois):
#   pnpm db:setup-test    # Créer DB + migrations + seed
#
# Lancer les tests E2E:
#   pnpm test:e2e         # Headless mode
#   pnpm test:e2e:ui      # UI mode (interactive)
#
# Isolation des tests:
#   - Chaque test nettoie ses données (afterEach hooks)
#   - Database locale isolée de dev/prod
#   - Testnet crypto (pas d'argent réel)
#   - PostgreSQL local (pas besoin de Docker)
# ==============================================================================

# ------------------------------------------------------------------------------
# 🔴 REDIS (Upstash) - SSE pub/sub and BullMQ
# ------------------------------------------------------------------------------
# Get from: https://console.upstash.com/redis
REDIS_URL="rediss://default:YOUR_UPSTASH_PASSWORD@your-redis.upstash.io:6379"
