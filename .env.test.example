# ==============================================================================
# 🧪 TEST ENVIRONMENT VARIABLES (TEMPLATE)
# ==============================================================================
# This file is a TEMPLATE for .env.test used in Playwright E2E tests
#
# 📝 SETUP INSTRUCTIONS:
# 1. Copy this file: cp .env.test.example .env.test
# 2. Fill in the values with your TEST credentials
# 3. NEVER commit .env.test (it's gitignored)
#
# ⚠️  SECURITY: Use test/dev credentials ONLY - NEVER production secrets
# ==============================================================================

# ------------------------------------------------------------------------------
# 🗄️  DATABASE (Local PostgreSQL container)
# ------------------------------------------------------------------------------
# Tests use a local PostgreSQL database (Docker container in CI)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mycryptopilot_test"
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/mycryptopilot_test"

# ------------------------------------------------------------------------------
# 🔐 AUTHENTICATION (Better Auth)
# ------------------------------------------------------------------------------
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=test-secret-key-for-ci-testing-only-not-production

# ------------------------------------------------------------------------------
# 🎭 OAUTH PROVIDERS (Tests - Use dev credentials)
# ------------------------------------------------------------------------------

## GitHub OAuth (Development credentials)
GITHUB_CLIENT_ID="your-github-test-client-id"
GITHUB_CLIENT_SECRET="your-github-test-client-secret"

## Google OAuth (Not used in tests)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

## Discord OAuth (Not used in tests)
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# ------------------------------------------------------------------------------
# 🤖 DISCORD BOT (Disabled in tests)
# ------------------------------------------------------------------------------
DISCORD_BOT_TOKEN=""
DISCORD_GUILD_ID=""
DISCORD_BOT_ENABLED="false"

# ------------------------------------------------------------------------------
# 📧 EMAIL (Optional for tests - can be empty)
# ------------------------------------------------------------------------------
RESEND_API_KEY=""
RESEND_AUDIENCE_ID=""
EMAIL_FROM="test@mycryptopilot.app"
NEXT_PUBLIC_EMAIL_CONTACT="test@mycryptopilot.app"

# ------------------------------------------------------------------------------
# 💳 CRYPTO PAYMENTS (Not tested yet)
# ------------------------------------------------------------------------------
BASE_RPC_URL=""
TRON_RPC_URL=""
CRYPTO_XPUB_BASE=""
CRYPTO_XPUB_TRON=""

# ------------------------------------------------------------------------------
# 💰 STRIPE (Legacy - Empty for tests)
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRO_PLAN_ID=""
STRIPE_PRO_YEARLY_PLAN_ID=""
STRIPE_ULTRA_PLAN_ID=""
STRIPE_ULTRA_YEARLY_PLAN_ID=""

# ------------------------------------------------------------------------------
# 📊 ANALYTICS (Disabled in tests)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST=""

# ------------------------------------------------------------------------------
# 📁 FILE UPLOAD (Disabled in tests)
# ------------------------------------------------------------------------------
UPLOADTHING_TOKEN=""
