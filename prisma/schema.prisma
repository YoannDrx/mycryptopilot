generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Feedback {
  id        String   @id @default(nanoid(11))
  review    Int
  message   String
  email     String?
  userId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id])
}

model TraderProfile {
  id              String    @id @default(cuid())
  userId          String    @unique
  displayName     String
  bio             String?
  priceMonthlyUSD Int       @default(0)
  statsJson       Json?
  verified        Boolean   @default(false)
  verifiedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("trader_profile")
}

model CryptoAddress {
  id             String          @id @default(cuid())
  userId         String
  network        CryptoNetwork
  address        String          @unique
  derivationPath String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments       CryptoPayment[]

  @@index([userId])
  @@map("crypto_address")
}

model Follow {
  id           String       @id @default(cuid())
  userId       String
  traderId     String
  status       FollowStatus @default(ACTIVE)
  source       FollowSource @default(DIRECT)
  invitationId String?
  startedAt    DateTime     @default(now())
  expiresAt    DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  trader       User         @relation("TraderFollowers", fields: [traderId], references: [id], onDelete: Cascade)
  user         User         @relation("UserFollows", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, traderId])
  @@index([traderId])
  @@index([source])
  @@map("follow")
}

model CryptoPayment {
  id            String         @id @default(cuid())
  userId        String
  addressId     String?
  network       CryptoNetwork
  txHash        String         @unique
  amountToken   Decimal        @db.Decimal(38, 18)
  amountUSD     Decimal        @db.Decimal(18, 2)
  currency      String
  confirmations Int            @default(0)
  status        PaymentStatus  @default(PENDING)
  confirmedAt   DateTime?
  plan          String
  daysGranted   Int            @default(30)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  address       CryptoAddress? @relation(fields: [addressId], references: [id])
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([txHash])
  @@map("crypto_payment")
}

model Signal {
  id          String   @id @default(cuid())
  traderId    String
  symbol      String
  payloadJson Json
  ttlSec      Int
  hash        String   @unique
  createdAt   DateTime @default(now())
  expiresAt   DateTime
  trader      User     @relation(fields: [traderId], references: [id], onDelete: Cascade)

  @@index([traderId])
  @@index([createdAt])
  @@map("signal")
}

model TraderInvitation {
  id         String           @id @default(cuid())
  traderId   String
  email      String
  token      String           @unique
  status     InvitationStatus @default(PENDING)
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  trader     User             @relation(fields: [traderId], references: [id], onDelete: Cascade)

  @@unique([traderId, email])
  @@index([token])
  @@index([traderId])
  @@index([status])
  @@map("trader_invitation")
}

enum UserRole {
  USER
  TRADER
  BOTH
}

enum FollowStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum FollowSource {
  DIRECT
  INVITATION
  REFERRAL
}

enum CryptoNetwork {
  BASE
  TRON
  POLYGON
  ETHEREUM
}

enum InvoiceStatus {
  OPEN
  PAID
  EXPIRED
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
}
