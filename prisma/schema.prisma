generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Feedback {
  id        String   @id @default(nanoid(11))
  review    Int
  message   String
  email     String?
  userId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id])
}

model TraderProfile {
  id                    String                       @id @default(cuid())
  userId                String                       @unique
  displayName           String
  bio                   String?
  statsJson             Json?
  verified              Boolean                      @default(false)
  verifiedAt            DateTime?
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt
  user                  User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  exchangeConnections   ExchangeConnection[]
  performanceSnapshots  TraderPerformanceSnapshot[]
  traderTrades          TraderTrade[]

  @@map("trader_profile")
}

model ExchangeConnection {
  id                 String          @id @default(cuid())
  traderProfileId    String
  trader             TraderProfile   @relation(fields: [traderProfileId], references: [id], onDelete: Cascade)
  exchange           Exchange
  encryptedApiKey    String          @db.Text
  encryptedSecretKey String          @db.Text
  keyIv              String
  keyTag             String
  isActive           Boolean         @default(true)
  lastSyncedAt       DateTime?
  lastSyncError      String?         @db.Text
  lastEmailSentAt    DateTime?       // Email rate limiting (max 1/day)
  nextSyncAt         DateTime?
  trades             ExchangeTrade[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@unique([traderProfileId, exchange])
  @@index([traderProfileId])
  @@index([isActive, nextSyncAt])
  @@map("exchange_connection")
}

model ExchangeTrade {
  id              String             @id @default(cuid())
  connectionId    String
  connection      ExchangeConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  traderTradeId   String?            // NOUVEAU: Lien vers TraderTrade agrégé
  traderTrade     TraderTrade?       @relation(fields: [traderTradeId], references: [id])
  externalOrderId String             @unique
  symbol          String
  side            TradeSide
  type            OrderType
  quantity        Decimal            @db.Decimal(20, 8)
  price           Decimal            @db.Decimal(20, 8)
  quoteQuantity   Decimal            @db.Decimal(20, 8)
  fee             Decimal            @db.Decimal(20, 8)
  feeAsset        String
  realizedPnl     Decimal?           @db.Decimal(20, 8)
  executedAt      DateTime
  createdAt       DateTime           @default(now())

  @@index([connectionId, executedAt])
  @@index([symbol])
  @@index([executedAt])
  @@index([traderTradeId])
  @@map("exchange_trade")
}

model TraderPerformanceSnapshot {
  id              String            @id @default(cuid())
  traderProfileId String
  trader          TraderProfile     @relation(fields: [traderProfileId], references: [id], onDelete: Cascade)
  period          PerformancePeriod
  totalTrades     Int
  winningTrades   Int
  losingTrades    Int
  winrate         Decimal           @db.Decimal(5, 2)
  totalProfits    Decimal           @db.Decimal(20, 8)
  totalLosses     Decimal           @db.Decimal(20, 8)
  netPnl          Decimal           @db.Decimal(20, 8)
  profitFactor    Decimal           @db.Decimal(10, 4)
  sharpeRatio     Decimal?          @db.Decimal(10, 4)
  sortinoRatio    Decimal?          @db.Decimal(10, 4)
  maxDrawdown     Decimal           @db.Decimal(10, 4)
  averageWin      Decimal           @db.Decimal(20, 8)
  averageLoss     Decimal           @db.Decimal(20, 8)
  largestWin      Decimal           @db.Decimal(20, 8)
  largestLoss     Decimal           @db.Decimal(20, 8)
  calculatedAt    DateTime
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([traderProfileId, period])
  @@index([traderProfileId])
  @@index([calculatedAt])
  @@map("trader_performance_snapshot")
}

model CryptoAddress {
  id             String          @id @default(cuid())
  userId         String
  network        CryptoNetwork
  address        String          @unique
  derivationPath String?
  isActive       Boolean         @default(true)
  sweptAt        DateTime?       // Timestamp when funds were swept to Binance
  sweptTxHash    String?         // Transaction hash of the sweep transaction
  createdAt      DateTime        @default(now())
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments       CryptoPayment[]

  @@index([userId])
  @@index([sweptAt])
  @@map("crypto_address")
}

model Follow {
  id           String       @id @default(cuid())
  userId       String
  traderId     String
  status       FollowStatus @default(ACTIVE)
  source       FollowSource @default(DIRECT)
  invitationId String?
  startedAt    DateTime     @default(now())
  expiresAt    DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  trader       User         @relation("TraderFollowers", fields: [traderId], references: [id], onDelete: Cascade)
  user         User         @relation("UserFollows", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, traderId])
  @@index([traderId])
  @@index([source])
  @@map("follow")
}

model CryptoPayment {
  id            String         @id @default(cuid())
  userId        String
  addressId     String?
  network       CryptoNetwork
  txHash        String         @unique
  amountToken   Decimal        @db.Decimal(38, 18)
  amountUSD     Decimal        @db.Decimal(18, 2)
  currency      String
  confirmations Int            @default(0)
  status        PaymentStatus  @default(PENDING)
  confirmedAt   DateTime?
  plan          String
  daysGranted   Int            @default(30)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  address       CryptoAddress? @relation(fields: [addressId], references: [id])
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([txHash])
  @@map("crypto_payment")
}

model Signal {
  id            String        @id @default(cuid())
  traderId      String
  symbol        String
  payloadJson   Json
  ttlSec        Int
  hash          String        @unique
  linkedTradeId String?       // NOUVEAU: Lien vers TraderTrade
  createdAt     DateTime      @default(now())
  expiresAt     DateTime
  trader        User          @relation(fields: [traderId], references: [id], onDelete: Cascade)
  linkedTrade   TraderTrade?  @relation(fields: [linkedTradeId], references: [id])

  @@index([traderId])
  @@index([createdAt])
  @@index([linkedTradeId])
  @@map("signal")
}

model TraderInvitation {
  id                  String           @id @default(cuid())
  traderId            String
  email               String
  token               String           @unique
  status              InvitationStatus @default(PENDING)
  expiresAt           DateTime
  acceptedAt          DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  // Nouveaux champs pour système de referral avancé
  source              InvitationSource @default(EMAIL)
  customMessage       String?
  landingViews        Int              @default(0)
  clickedAt           DateTime?        // Première visite landing page
  creditsAwarded      Int              @default(0) // Total credits donnés pour cette invite
  inviteeActive       Boolean          @default(false) // 30+ jours actif
  inviteeUpgraded     Boolean          @default(false)
  inviteeUpgradedPlan String?          // "pro" ou "ultra"
  inviteeUpgradedAt   DateTime?
  personalMessage     String?          // Message personnalisé du trader (optionnel)

  // Anti-gaming & fraud detection
  signupIp            String?          // IP address du signup (détection same IP)
  isSuspicious        Boolean          @default(false) // Flagged for review
  suspiciousReason    String?          // Reason for flagging
  reviewedAt          DateTime?        // When admin reviewed
  reviewedBy          String?          // Admin user ID who reviewed

  trader              User             @relation(fields: [traderId], references: [id], onDelete: Cascade)

  @@unique([traderId, email])
  @@index([token])
  @@index([traderId])
  @@index([status])
  @@index([source])
  @@map("trader_invitation")
}

model ReferralCredit {
  id        String     @id @default(cuid())
  traderId  String
  amount    Int        // Peut être négatif (dépense)
  type      CreditType
  reason    String?
  metadata  Json?      // { inviteeId, plan, etc. }
  createdAt DateTime   @default(now())
  trader    User       @relation(fields: [traderId], references: [id], onDelete: Cascade)

  @@index([traderId])
  @@index([createdAt])
  @@index([type])
  @@map("referral_credit")
}

model ReferralReward {
  id             String   @id @default(cuid())
  traderId       String
  inviteeId      String?
  action         String   // "signup", "active_30d", "upgrade_pro", etc.
  creditsAwarded Int
  metadata       Json?
  createdAt      DateTime @default(now())
  trader         User     @relation(fields: [traderId], references: [id], onDelete: Cascade)

  @@index([traderId])
  @@index([createdAt])
  @@index([action])
  @@map("referral_reward")
}

model ReferralTier {
  id                 String    @id @default(cuid())
  traderId           String    @unique
  tier               TierLevel @default(BRONZE)
  activeInvitesCount Int       @default(0) // Cache pour performance
  tierUpgradedAt     DateTime? // Dernière upgrade de tier
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  trader             User      @relation(fields: [traderId], references: [id], onDelete: Cascade)

  @@index([tier])
  @@index([activeInvitesCount])
  @@map("referral_tier")
}

model FraudLog {
  id          String   @id @default(cuid())
  traderId    String?
  userId      String?
  type        String   // "SAME_IP", "DISPOSABLE_EMAIL", "RAPID_SIGNUPS", "INACTIVE_USER", etc.
  description String
  metadata    Json?    // Additional context (IP, email, etc.)
  severity    String   // "LOW", "MEDIUM", "HIGH", "CRITICAL"
  resolved    Boolean  @default(false)
  resolvedAt  DateTime?
  resolvedBy  String?  // Admin user ID
  createdAt   DateTime @default(now())

  @@index([traderId])
  @@index([userId])
  @@index([type])
  @@index([severity])
  @@index([resolved])
  @@index([createdAt])
  @@map("fraud_log")
}

// ============================================================================
// UNIFIED TRADING SYSTEM MODELS
// ============================================================================

model TraderTrade {
  id               String             @id @default(cuid())
  traderProfileId  String
  trader           TraderProfile      @relation(fields: [traderProfileId], references: [id], onDelete: Cascade)

  // Source & Type
  source           TradeSource        // BINANCE, BYBIT, MANUAL
  instrumentType   InstrumentType     // SPOT, FUTURES
  symbol           String             // e.g., "BTC/USDT"

  // Position Data
  status           TradeStatus        // OPEN, CLOSED, PARTIAL
  side             TradeSide          // BUY, SELL (LONG, SHORT for Futures)

  // Quantities & Prices
  totalQuantity    Decimal            @db.Decimal(20, 8)  // DEPRECATED: kept for backward compatibility
  entryQuantity    Decimal            @default(0) @db.Decimal(20, 8)  // Total quantity bought/longed
  exitQuantity     Decimal            @default(0) @db.Decimal(20, 8)  // Total quantity sold/shorted
  netQuantity      Decimal            @default(0) @db.Decimal(20, 8)  // entryQuantity - exitQuantity (current position)
  averageEntry     Decimal            @db.Decimal(20, 8)  // Average entry price
  averageExit      Decimal?           @db.Decimal(20, 8)  // Average exit price (if closed)

  // Risk Management
  stopLoss         Decimal?           @db.Decimal(20, 8)  // NULL for exchange trades (Phase 1)
  takeProfit       Json?              // Array of TPs, NULL for exchange trades

  // Performance
  realizedPnl      Decimal?           @db.Decimal(20, 8)  // PnL if closed
  fees             Decimal            @db.Decimal(20, 8)  // Total fees

  // Metadata
  notes            String?            @db.Text            // Optional notes for manual trades

  // Timestamps
  openedAt         DateTime           // First entry
  closedAt         DateTime?          // Last exit (if closed)
  lastActivityAt   DateTime           // Last modification

  // Relations
  fills            ExchangeTrade[]    // Raw fills from exchange (if source != MANUAL)
  signals          Signal[]           // Signals created from this trade
  copies           CopyTrade[]        // Copies by users

  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([traderProfileId, status])
  @@index([symbol])
  @@index([openedAt])
  @@map("trader_trade")
}

model UserExchangeConnection {
  id                 String        @id @default(cuid())
  userId             String
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  exchange           Exchange      // BINANCE, BYBIT

  // Encrypted API credentials
  encryptedApiKey    String        @db.Text
  encryptedSecretKey String        @db.Text
  keyIv              String
  keyTag             String

  // Configuration
  mode               CopyMode      // MANUAL, AUTO
  isActive           Boolean       @default(true)

  // Metadata
  lastSyncedAt       DateTime?
  lastError          String?       @db.Text

  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@unique([userId, exchange])
  @@index([userId])
  @@map("user_exchange_connection")
}

model CopyTrade {
  id                String        @id @default(cuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Source
  originalTradeId   String        // TraderTrade.id
  originalTrade     TraderTrade   @relation(fields: [originalTradeId], references: [id], onDelete: Cascade)

  // Copy Configuration
  mode              CopyMode      // MANUAL, AUTO
  status            CopyStatus    // PENDING, EXECUTED, FAILED, CANCELLED

  // Execution (if AUTO)
  exchangeOrderId   String?       // Order ID on user's exchange
  executedPrice     Decimal?      @db.Decimal(20, 8)  // Actual execution price
  executedQuantity  Decimal?      @db.Decimal(20, 8)  // Actual executed quantity
  slippage          Decimal?      @db.Decimal(10, 4)  // Price difference percentage

  // Manual tracking (if MANUAL)
  manualEntry       Decimal?      @db.Decimal(20, 8)  // Manual entry price
  manualExit        Decimal?      @db.Decimal(20, 8)  // Manual exit price
  manualPnl         Decimal?      @db.Decimal(20, 8)  // Manual PnL calculation
  notes             String?       @db.Text            // Personal notes

  // Risk Management
  stopLoss          Decimal?      @db.Decimal(20, 8)  // Custom SL
  takeProfit        Json?         // Custom TPs

  // Timestamps
  copiedAt          DateTime      @default(now())
  executedAt        DateTime?     // When executed (if AUTO)
  closedAt          DateTime?     // When closed

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([userId, status])
  @@index([originalTradeId])
  @@map("copy_trade")
}

enum UserRole {
  USER
  TRADER
  BOTH
}

enum FollowStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum FollowSource {
  DIRECT
  INVITATION
  REFERRAL
}

enum CryptoNetwork {
  BASE
  TRON
  POLYGON
  ETHEREUM
}

enum InvoiceStatus {
  OPEN
  PAID
  EXPIRED
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
}

enum InvitationSource {
  EMAIL             // Invitation par email (60d trial + 25 credits)
  LINK              // Referral link public (30d trial)
  SOCIAL_TWITTER    // Via partage Twitter
  SOCIAL_TELEGRAM   // Via partage Telegram
  SOCIAL_WHATSAPP   // Via partage WhatsApp
}

enum CreditType {
  // Credits earned
  EARNED_SIGNUP           // +5 credits (invitation acceptée)
  EARNED_ACTIVE           // +10 credits (30+ jours actif)
  EARNED_UPGRADE_PRO      // +50 credits (upgrade Pro)
  EARNED_UPGRADE_ULTRA    // +100 credits (upgrade Ultra)
  EARNED_RETENTION_3M     // +25 credits (reste 3 mois)

  // Credits spent
  SPENT_PRO_MONTH         // -100 credits (1 mois Pro gratuit)
  SPENT_ULTRA_MONTH       // -200 credits (1 mois Ultra gratuit)
  SPENT_FEATURED          // -50 credits (Featured placement 1 semaine)
  SPENT_ANALYTICS         // -30 credits (Analytics premium)
  SPENT_PROFILE_BOOST     // -75 credits (Profile boost 2x visibility)
  SPENT_CUSTOM_BADGE      // -150 credits (Custom badge)

  // Clawback
  CLAWBACK_FRAUD          // Retrait en cas de fraude détectée
}

enum TierLevel {
  BRONZE                  // 0-9 invités actifs
  SILVER                  // 10-49 invités actifs
  GOLD                    // 50-99 invités actifs
  DIAMOND                 // 100+ invités actifs
}

enum Exchange {
  BINANCE
  BYBIT
}

enum TradeSide {
  BUY
  SELL
}

enum OrderType {
  MARKET
  LIMIT
  STOP_LOSS
  STOP_LOSS_LIMIT
  TAKE_PROFIT
  TAKE_PROFIT_LIMIT
}

enum PerformancePeriod {
  ALL_TIME
  LAST_30D
  LAST_90D
  LAST_365D
}

// ============================================================================
// UNIFIED TRADING SYSTEM ENUMS
// ============================================================================

enum TradeSource {
  BINANCE
  BYBIT
  MANUAL
}

enum InstrumentType {
  SPOT
  FUTURES
}

enum TradeStatus {
  OPEN
  CLOSED
  PARTIAL    // Partially closed
}

enum CopyMode {
  MANUAL     // User journal, no execution
  AUTO       // Automatic execution via API
}

enum CopyStatus {
  PENDING    // Waiting for execution
  EXECUTED   // Successfully executed
  CLOSED     // Position closed
  FAILED     // Execution failed
  CANCELLED  // Cancelled by user
}
