# ==============================================================================
# 🚀 PRODUCTION ENVIRONMENT VARIABLES (Railway)
# ==============================================================================
# This file is a TEMPLATE for production deployment on Railway
# DO NOT commit this file with real secrets!
#
# Instructions:
# 1. Copy this file: cp .env.production.template .env.production
# 2. Fill in the values below
# 3. Use Railway CLI or Dashboard to set these variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 🗄️  DATABASE (Neon Production)
# ------------------------------------------------------------------------------
# ⚠️  IMPORTANT: Use the SAME URL as Vercel production!
# Get from: Vercel Dashboard → Settings → Environment Variables → DATABASE_URL
DATABASE_URL="postgresql://neondb_owner:***@ep-proud-term-PRODUCTION-pooler.eu-west-2.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://neondb_owner:***@ep-proud-term-PRODUCTION.eu-west-2.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 🔐 AUTHENTICATION (Better Auth)
# ------------------------------------------------------------------------------
# ⚠️  IMPORTANT: Use the SAME SECRET as Vercel production!
# Get from: Vercel Dashboard → Settings → Environment Variables → BETTER_AUTH_SECRET
BETTER_AUTH_URL=https://mycryptopilot.com
BETTER_AUTH_SECRET="your-production-secret-from-vercel"

# ------------------------------------------------------------------------------
# 🤖 DISCORD BOT (Production)
# ------------------------------------------------------------------------------
# Get from: Discord Developer Portal
# Same as development (bot token doesn't change between dev/prod)
DISCORD_BOT_TOKEN="your-discord-bot-token"
DISCORD_GUILD_ID="your-discord-guild-id"
DISCORD_BOT_ENABLED="true"

# ------------------------------------------------------------------------------
# 🌐 ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV="production"

# ------------------------------------------------------------------------------
# 📧 EMAIL (Resend - Optional for bot)
# ------------------------------------------------------------------------------
# Only needed if bot sends emails (not required for basic functionality)
# RESEND_API_KEY="re_your_production_api_key"
# RESEND_AUDIENCE_ID="your-audience-id"
# EMAIL_FROM="bot@mycryptopilot.app"

# ==============================================================================
# DEPLOYMENT INSTRUCTIONS
# ==============================================================================
#
# Option 1: Railway Dashboard
# 1. Go to: https://railway.app/dashboard
# 2. Select your project
# 3. Variables tab → Add each variable above
#
# Option 2: Railway CLI
# railway variables set DISCORD_BOT_TOKEN="your_token"
# railway variables set DISCORD_GUILD_ID="your_guild_id"
# railway variables set DISCORD_BOT_ENABLED="true"
# railway variables set DATABASE_URL="your_neon_url"
# railway variables set BETTER_AUTH_SECRET="your_secret"
# railway variables set NODE_ENV="production"
#
# Option 3: Automated Script
# ./scripts/deploy-railway.sh
#
# ==============================================================================
