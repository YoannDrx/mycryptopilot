# =============================================================================

# ENVIRONMENT CONFIGURATION TEMPLATE

# =============================================================================

#

# Copy this file to create your environment-specific files:

# - .env.development → Local development

# - .env.production → Production (Vercel uses its own env vars)

# - .env.test → E2E tests

#

# See docs/neon-setup.md for complete setup guide

# =============================================================================

# Database URL (Neon PostgreSQL)

# Development: Use your dev branch (e.g., ep-falling-bar-ab0lufee)

# Production: Use your main branch (e.g., ep-proud-term-abutee8y)

# https://neon.tech/docs/guides/prisma

DATABASE_URL=""
DATABASE_URL_UNPOOLED=""

## \* BetterAuth

BETTER_AUTH_URL=http://localhost:3000 # Change to https://www.mycryptopilot.app in production
BETTER_AUTH_SECRET="" # Generate with: openssl rand -base64 32

## \* OAuth Providers

GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

## \* Resend (Email)

RESEND_API_KEY=""
RESEND_AUDIENCE_ID=""
EMAIL_FROM="contact@mycryptopilot.app"
NEXT_PUBLIC_EMAIL_CONTACT="contact@mycryptopilot.app"

## \* Stripe (legacy - non utilisé, conservé pour compatibilité)

STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRO_PLAN_ID=""
STRIPE_PRO_YEARLY_PLAN_ID=""
STRIPE_ULTRA_PLAN_ID=""
STRIPE_ULTRA_YEARLY_PLAN_ID=""

## \* Analytics

NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST=""

## \* Upload

UPLOADTHING_TOKEN=""

## \* Crypto Payment (MyCryptoPilot specific)

# Base network RPC URL (for USDC payment detection)
# Public RPC: https://mainnet.base.org or https://base-mainnet.public.blastapi.io
# Alchemy: https://base-mainnet.g.alchemy.com/v2/YOUR_API_KEY
BASE_RPC_URL="https://mainnet.base.org"

# Tron network RPC URL (for USDT payment detection)
# Public RPC: https://api.trongrid.io
# TronGrid: https://api.trongrid.io or https://api.shasta.trongrid.io (testnet)
TRON_RPC_URL="https://api.trongrid.io"

# Extended public keys for HD wallet address generation
# Generate with: scripts/generate-xpub.sh (to be created)
# Base uses Ethereum derivation path: m/44'/60'/0'/0/n
# Tron uses Tron derivation path: m/44'/195'/0'/0/n
CRYPTO_XPUB_BASE=""
CRYPTO_XPUB_TRON=""
