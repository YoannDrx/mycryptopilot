# ==============================================================================
# 🔐 SWEEP CONFIGURATION - SEED PHRASES FOR SWEEPING FUNDS TO BINANCE
# ==============================================================================
#
# ⚠️  CRITICAL SECURITY WARNING:
#   - Copy this file to .env.sweep (gitignored)
#   - NEVER commit .env.sweep to Git
#   - Store seed phrases in password manager (1Password, Bitwarden)
#   - Loss of seed phrases = PERMANENT LOSS OF FUNDS
#
# ==============================================================================

# ------------------------------------------------------------------------------
# 🔑 SEED PHRASES (24 words - MAINNET PRODUCTION)
# ------------------------------------------------------------------------------
# These are the SAME seed phrases you generated with:
#   npx tsx scripts/generate-mainnet-xpubs.ts
#
# IMPORTANT: You MUST use the same mnemonics that generated your XPUBs!
# Otherwise, the script won't be able to access the funds.
# ------------------------------------------------------------------------------

## Base Network (USDC) - 24 words seed phrase
# Example: word1 word2 word3 ... word24
SWEEP_MNEMONIC_BASE=""

## Tron Network (USDT) - 24 words seed phrase
SWEEP_MNEMONIC_TRON=""

# ------------------------------------------------------------------------------
# 🏦 BINANCE DEPOSIT ADDRESSES (Your Binance wallets)
# ------------------------------------------------------------------------------
# Get these from Binance:
#   1. Go to Wallet → Fiat and Spot → Deposit
#   2. Select USDC → Base network (for Base)
#   3. Select USDT → TRC20 network (for Tron)
#   4. Copy the deposit addresses below
# ------------------------------------------------------------------------------

## Base Network - USDC Deposit Address (0x...)
# Example: 0x742d35Cc6634C0532925a3b844Bc9e7595f0bEb1
BINANCE_MASTER_WALLET_BASE=""

## Tron Network - USDT Deposit Address (T...)
# Example: TJDENsfBJs4RFETt1X1W8wMDc8M5XnJhCe
BINANCE_MASTER_WALLET_TRON=""

# ------------------------------------------------------------------------------
# ⚙️  SWEEP CONFIGURATION (Optional - uses defaults if not set)
# ------------------------------------------------------------------------------

## Minimum balance threshold for sweep (in USD)
# Default: 10 (won't sweep addresses with less than $10)
SWEEP_MIN_THRESHOLD_USD="10"

## Dry-run mode (set to "false" to execute real transactions)
# Default: true (safe mode - preview only, no real transfers)
DRY_RUN="true"

# ------------------------------------------------------------------------------
# 📧 NOTIFICATIONS (Optional)
# ------------------------------------------------------------------------------

## Email notification after sweep (uses RESEND_API_KEY from main .env)
# Default: false
SWEEP_EMAIL_NOTIFICATION="false"

## Your email to receive sweep notifications
SWEEP_NOTIFICATION_EMAIL=""

# ==============================================================================
# 📚 SETUP INSTRUCTIONS
# ==============================================================================
#
# 1. Copy this file:
#    cp .env.sweep.example .env.sweep
#
# 2. Fill in your seed phrases (24 words each):
#    - SWEEP_MNEMONIC_BASE
#    - SWEEP_MNEMONIC_TRON
#
# 3. Get your Binance deposit addresses:
#    - BINANCE_MASTER_WALLET_BASE (Base USDC)
#    - BINANCE_MASTER_WALLET_TRON (Tron USDT)
#
# 4. Test in dry-run mode:
#    npx tsx scripts/sweep-to-binance.ts
#
# 5. Execute real sweep:
#    DRY_RUN=false npx tsx scripts/sweep-to-binance.ts
#
# ==============================================================================
# 🆘 TROUBLESHOOTING
# ==============================================================================
#
# Error: "Cannot derive private key"
#   → Verify seed phrases are correct (24 words with spaces)
#   → Check they match the XPUBs you're using
#
# Error: "Insufficient ETH for gas fees"
#   → Send some ETH to payment addresses first
#   → Or use a gas station wallet (see docs)
#
# Error: "Binance wallet not configured"
#   → Fill in BINANCE_MASTER_WALLET_BASE/TRON
#
# ==============================================================================
